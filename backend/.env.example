# Local backend configuration for `mvn spring-boot:run`.
# Copy to .env (not read automatically) or export these variables.

DB_URL=jdbc:postgresql://localhost:5432/smartprint_db
DB_USER=smartprint
DB_PASSWORD=change_me_local
DB_POOL_SIZE=10

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=smartprint
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=smartprint-documents
MINIO_SECURE=false
MINIO_PRESIGNED_URL_MINUTES=15

CORS_ALLOWED_ORIGINS=http://localhost:5173
SHOP_CODE=SHOP001
UPLOAD_MAX_FILE_SIZE=20MB
UPLOAD_MAX_REQUEST_SIZE=100MB
UPLOAD_MAX_FILE_SIZE_BYTES=20971520

# JWT_SECRET is required from Phase 2 onwards. Use at least 32 random bytes.
# JWT_SECRET=replace_with_a_long_random_secret
