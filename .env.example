# Copy to .env and change every secret before any non-local deployment.

# PostgreSQL
# If a local PostgreSQL already listens on 5432, publish this stack elsewhere, e.g. 5434.
POSTGRES_DB=smartprint_db
POSTGRES_USER=smartprint
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432

# MinIO (S3-compatible private object storage)
MINIO_ROOT_USER=smartprint
MINIO_ROOT_PASSWORD=change_me_minio
# Official MinIO Docker Hub images were withdrawn. For local development the pinned
# community mirror below is used. Point this at your own registry image elsewhere.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_BUCKET=smartprint-documents
# Change these if another MinIO/service already owns 9000/9001 (e.g. 9010/9011).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
SHOP_CODE=SHOP001
SPRING_PROFILES_ACTIVE=prod

# Server-side pricing (shop currency per printed page).
PRICE_BW_PER_PAGE=2.00
PRICE_COLOR_PER_PAGE=10.00

# Manual mobile-wallet numbers shown in customer payment instructions.
BKASH_NUMBER=
NAGAD_NUMBER=

# Frontend (Nginx)
FRONTEND_PORT=8081

# Browser origin encoded in downloadable QR codes. Use the HTTPS origin for real shops.
PUBLIC_BASE_URL=http://localhost:8081
# Generate with openssl rand -hex 32. Use the same secret across restarts.
JWT_SECRET=
