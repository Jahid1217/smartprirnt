SMARTPRINT_API_BASE=http://localhost:8080/api/v1
AGENT_CODE=SHOP001-AGENT01
AGENT_TOKEN=replace_with_agent_secret
POLL_SECONDS=5
# Optional system CUPS Unix socket
# CUPS_SOCKET=/run/cups/cups.sock
# AGENT_STATE_DIR=/var/lib/smartprint-agent
DRY_RUN=false

# Set to the admin browser origin when it differs from the API origin (e.g. development).
# SMARTPRINT_BROWSER_ORIGIN=http://localhost:8081

# For trusted private LAN development when the backend runs on a different computer.
# SMARTPRINT_API_BASE=http://192.168.1.20:8081/api/v1
# SMARTPRINT_ALLOW_LAN_HTTP=true

# Optional overrides for packaged installations
# SMARTPRINT_AGENT_CONFIG=/etc/smartprint-agent/agent.conf
# SMARTPRINT_CREDENTIAL_FILE=/etc/smartprint-agent/credentials.enc
SPOOL_TIMEOUT_SECONDS=3600
